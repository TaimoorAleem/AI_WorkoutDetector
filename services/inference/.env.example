# inference-svc configuration. Everything comes from the environment; nothing here is a real secret.
# Copy to .env (gitignored) for local runs.

# dev | test | prod. POST /v1/analyze (synchronous debugging) exists only in dev and test.
APP_ENV=dev
PORT=8000

# RabbitMQ (the service declares inference.session-uploaded, its retry/delay queues and its DLQ)
AMQP_URL=amqp://proprio:change-me@localhost:5672/%2F
AMQP_EXCHANGE=proprio.events

# S3-compatible storage: MinIO locally, IBM COS later. Leave S3_ENDPOINT empty for real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=proprio-raw
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Model: a directory written by `python -m proprio_inference.train_model --out <dir>`, or an MLflow
# URI (runs:/<run_id>/model, models:/proprio-classifier@production).
MODEL_URI=./models/proprio-classifier
# Share of windows the winning lift class needs to be logged. Placeholder until the U2 data sets it.
TAU=0.6

# device_model=profile[|fallback profile],... ; the first profile that exists is used.
PROFILE_MAP=SM-R920=galaxy-watch5pro-fit-v1|galaxy-watch-prior-v0

# Retry delays (ms) for transient errors: one retry queue per entry, then DLQ + a failed event.
RETRY_DELAYS_MS=5000,15000,45000
# Run the AMQP worker inside the API process (default). Set false to run it separately with
# `python -m proprio_inference.worker`.
WORKER_ENABLED=true
