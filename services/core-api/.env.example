# core-api configuration (all values come from the environment; nothing here is a real secret).
# Copy to .env (gitignored) and adjust. The dev profile reads these through application.yml.

SPRING_PROFILES_ACTIVE=dev
PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/proprio
DB_USER=proprio
DB_PASSWORD=change-me

# RabbitMQ
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=proprio
RABBIT_PASSWORD=change-me
RABBIT_VHOST=/

# S3-compatible object storage: MinIO locally, IBM Cloud Object Storage later.
# S3_ENDPOINT is what core-api itself talks to; S3_PUBLIC_ENDPOINT (optional) is the host the phone can
# reach and is used only to sign presigned URLs (e.g. http://192.168.1.20:9000 while core-api reaches
# MinIO as http://minio:9000 inside compose). Leave S3_ENDPOINT empty for real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=proprio-raw
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_PATH_STYLE=true

# JWT signing key (RS256). REQUIRED outside the dev/test profiles; the dev profile generates an
# ephemeral key when both are empty. A PKCS#8 PEM, either inline (use \n for newlines) or as a file:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
JWT_PRIVATE_KEY=
JWT_PRIVATE_KEY_PATH=
JWT_ISSUER=https://proprio.dev/core-api
